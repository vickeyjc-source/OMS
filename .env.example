# ─────────────────────────────────────────────
#  Ciflux OMS  –  PostgreSQL connection config
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

PG_HOST=localhost
PG_PORT=5432
PG_DB=ciflux_oms
PG_USER=ciflux
PG_PASSWORD=ciflux_pass

# Optional: override the HTTP port (default 8080)
# PORT=8080
